# JobPilot AI Environment Variables
PROJECT_NAME="JobPilot AI"
SECRET_KEY="jobpilot-super-secret-jwt-key-change-in-production-2026"

# Supabase & PostgreSQL Connection Configuration
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Supabase Database URL (Use Transaction Pooler or Direct Connection)
# Example: postgresql+asyncpg://postgres.ref:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL="sqlite+aiosqlite:///./jobpilot.db"

# AI Provider Configuration (SMART_MOCK, OPENAI, GEMINI)
AI_PROVIDER="SMART_MOCK"
AI_API_KEY=""

# Resend Email Integration for OTP
RESEND_API_KEY="re_123456789_your_resend_api_key"
RESEND_FROM_EMAIL="JobPilot AI <onboarding@resend.dev>"

# Application Operational Mode
DEMO_MODE="true"

# Storage Configuration
STORAGE_DIR="./storage"
